# Copy this file to .env and fill in your values.

# OpenAI (or any OpenAI-compatible endpoint). If left blank, dating-chad
# runs in heuristic fallback mode so you can try it without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible base URL (e.g. a local LLM server)
OPENAI_BASE_URL=

# --- Using xAI Grok instead? It's OpenAI-compatible. Set: ---
#   OPENAI_API_KEY=<your key from console.x.ai>
#   OPENAI_BASE_URL=https://api.x.ai/v1
#   OPENAI_MODEL=grok-4.3        (or grok-4.1-fast for cheaper/faster)

# Server
HOST=127.0.0.1
PORT=8000

# Tinder unofficial connector (optional, advanced). See README for caveats.
# This is NOT an official API and may break / violate ToS. Use at your own risk.
TINDER_X_AUTH_TOKEN=
